--// =========================================================
--// REQUEST SYSTEM
--// =========================================================

local function UpdateRequestStatus()

	Status.Text =
		"Requests: "
		.. tostring(
			RequestCount
		)
end

local function CanSendRequest(
	Remote,
	Action,
	...
)

	if not Remote
	or not Remote:IsA("RemoteEvent") then
		return false
	end

	if typeof(Action) ~= "string" then
		return false
	end

	if RequestCount >= REQUEST_LIMIT then
		return false
	end

	local Now =
		os.clock()

	local Remaining =
		REQUEST_INTERVAL
		- (
			Now
			- LastRequestTime
		)

	if Remaining > 0 then
		task.wait(Remaining)
	end

	if not Remote.Parent
	or not Remote:IsDescendantOf(
		ReplicatedStorage
	) then
		return false
	end

	LastRequestTime =
		os.clock()

	RequestCount += 1

	Remote:FireServer(
		Action,
		...
	)

	return true
end

--// =========================================================
--// NAME COLOR
--// =========================================================

local function SendColor(
	Color
)

	if typeof(Color) ~= "Color3" then
		return false
	end

	if not Event then
		return false
	end

	local Sent =
		CanSendRequest(
			Event,
			"colo",
			Color
		)

	UpdateRequestStatus()

	return Sent
end

local function StartNameColor()

	task.spawn(function()

		while NameColorEnabled
		and RequestCount < REQUEST_LIMIT do

			if not SendColor(
				Colors[ColorIndex]
			) then
				break
			end

			ColorIndex += 1

			if ColorIndex > #Colors then
				ColorIndex = 1
			end
		end

		if RequestCount >=
			REQUEST_LIMIT then

			NameColorEnabled = false

			NameColorButton.Text =
				"NAME COLOR: OFF"

			SmallNotification(
				"REQUEST LIMIT REACHED",
				"Left"
			)
		end
	end)
end

