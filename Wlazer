end)

--//==================================================
--// COLOR LOOP
--//==================================================

local Enabled = false
local Running = false

ToggleScript.MouseButton1Click:Connect(function()
	Enabled = not Enabled

	if Enabled then
		ToggleScript.Text = "NAME COLOR: ON"
		ToggleScript.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		ToggleScript.TextColor3 = Color3.fromRGB(0, 0, 0)

		if Running then
			return
		end

		Running = true

		task.spawn(function()
			local Sent = 0

			while Enabled and Sent < REQUEST_LIMIT do
				for _, Color in ipairs(Colors) do
					if not Enabled or Sent >= REQUEST_LIMIT then
						break
					end

					if Event then
						Event:FireServer("colo", Color)
					end

					Sent += 1
					Status.Text = "Requests: " .. Sent .. " / " .. REQUEST_LIMIT

					if DELAY > 0 then
						task.wait(DELAY)
					else
						task.wait()
					end
				end
			end

			Running = false

			if not Enabled then
				ToggleScript.Text = "NAME COLOR: OFF"
				ToggleScript.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
				ToggleScript.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				ToggleScript.Text = "NAME COLOR: OFF"
				ToggleScript.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
				ToggleScript.TextColor3 = Color3.fromRGB(255, 255, 255)
				Enabled = false
			end
		end)

	else
		ToggleScript.Text = "NAME COLOR: OFF"
		ToggleScript.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
		ToggleScript.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end)

