--// UPDATE TAGS

local function UpdateAllSpecialTags()

	for _, TargetPlayer in ipairs(Players:GetPlayers()) do

		if TargetPlayer.Name == OWNER_USERNAME then

			CreateOwnerTag(TargetPlayer)
			RemoveCoOwnerTag(TargetPlayer)
			RemoveScriptUserTag(TargetPlayer)

		elseif TargetPlayer.Name == CO_OWNER_USERNAME then

			CreateCoOwnerTag(TargetPlayer)
			RemoveOwnerTag(TargetPlayer)
			RemoveScriptUserTag(TargetPlayer)

		elseif RegisteredPlayers[TargetPlayer.UserId] then

			CreateScriptUserTag(TargetPlayer)
			RemoveOwnerTag(TargetPlayer)
			RemoveCoOwnerTag(TargetPlayer)

		else

			RemoveOwnerTag(TargetPlayer)
			RemoveCoOwnerTag(TargetPlayer)
			RemoveScriptUserTag(TargetPlayer)
		end
	end
end

--// SETUP PLAYER

local function SetupPlayer(TargetPlayer)

	if not TargetPlayer then
		return
	end

	TargetPlayer.CharacterAdded:Connect(function()

		task.wait(0.2)

		if not TargetPlayer.Parent then
			return
		end

		if TargetPlayer.Name == OWNER_USERNAME then

			CreateOwnerTag(TargetPlayer)

		elseif TargetPlayer.Name == CO_OWNER_USERNAME then

			CreateCoOwnerTag(TargetPlayer)

		elseif RegisteredPlayers[TargetPlayer.UserId] then

			CreateScriptUserTag(TargetPlayer)
		end
	end)

	if TargetPlayer.Character then

		task.defer(function()

			if not TargetPlayer.Parent then
				return
			end

			if TargetPlayer.Name == OWNER_USERNAME then

				CreateOwnerTag(TargetPlayer)

			elseif TargetPlayer.Name == CO_OWNER_USERNAME then

				CreateCoOwnerTag(TargetPlayer)

			elseif RegisteredPlayers[TargetPlayer.UserId] then

				CreateScriptUserTag(TargetPlayer)
			end
		end)
	end
end

for _, TargetPlayer in ipairs(Players:GetPlayers()) do
	SetupPlayer(TargetPlayer)
end

