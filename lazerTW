--// NOTIFICATIONS

local ActiveNotifications = {}

local function SmallNotification(Text, Side)

	for _, Notification in ipairs(ActiveNotifications) do
		if Notification
			and Notification.Parent
			and Notification.Text == Text then

			Notification:Destroy()
		end
	end

	local Notification = Instance.new("TextLabel")

	Notification.Name = "LazerNotification"
	Notification.Size = UDim2.new(0, 245, 0, 34)

	if Side == "Right" then
		Notification.AnchorPoint = Vector2.new(1, 0)
		Notification.Position = UDim2.new(1, -12, 0, 20)
	else
		Notification.AnchorPoint = Vector2.new(0, 0)
		Notification.Position = UDim2.new(0, 12, 0, 20)
	end

	Notification.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	Notification.BackgroundTransparency = 1
	Notification.BorderSizePixel = 0

	Notification.Text = Text
	Notification.TextColor3 = Color3.fromRGB(255, 255, 255)
	Notification.TextSize = 11
	Notification.Font = Enum.Font.GothamBold
	Notification.TextTransparency = 1
	Notification.ZIndex = 100

	Notification.Parent = ScreenGui

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 9)
	Corner.Parent = Notification

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(255, 255, 255)
	Stroke.Transparency = 1
	Stroke.Parent = Notification

	table.insert(ActiveNotifications, Notification)

	TweenService:Create(
		Notification,
		TweenInfo.new(
			0.15,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			TextTransparency = 0,
			BackgroundTransparency = 0.08
		}
	):Play()

	TweenService:Create(
		Stroke,
		TweenInfo.new(
			0.15,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Transparency = 0.25
		}
	):Play()

	task.delay(6, function()

		if not Notification
			or not Notification.Parent then

			return
		end

		local FadeOut = TweenService:Create(
			Notification,
			TweenInfo.new(
				0.4,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.In
			),
			{
				TextTransparency = 1,
				BackgroundTransparency = 1
			}
		)

		TweenService:Create(
			Stroke,
			TweenInfo.new(
				0.4,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.In
			),
			{
				Transparency = 1
			}
		):Play()

		FadeOut:Play()
		FadeOut.Completed:Wait()

		if Notification then
			Notification:Destroy()
		end
	end)
end

