end

--//======================================================
--// UPDATE TAGS
--// EVERY REGISTERED SCRIPT USER SEES EVERY OTHER
--// REGISTERED SCRIPT USER
--//======================================================

local function UpdateTags()

	for _, Target in ipairs(
		Players:GetPlayers()
	) do

		--// OWNER
		if Target.Name == OWNER_USERNAME then

			MakeTag(
				Target,
				OWNER_TAG,
				"👑 OWNER",
				Color3.fromRGB(
					255,
					255,
					0
				),
				23
			)

			-- Only our tags.
			RemoveTag(
				Target,
				CO_OWNER_TAG
			)

			RemoveTag(
				Target,
				USER_TAG
			)

		--// CO OWNER
		elseif Target.Name == CO_OWNER_USERNAME then

			MakeTag(
				Target,
				CO_OWNER_TAG,
				"👑 CO OWNER",
				Color3.fromRGB(
					255,
					255,
					0
				),
				21
			)

			RemoveTag(
				Target,
				OWNER_TAG
			)

			RemoveTag(
				Target,
				USER_TAG
			)

		--// SCRIPT USER
		elseif RegisteredPlayers[
			Target.UserId
		] then

			-- EVERY SCRIPT USER GETS THE SAME TAG.
			-- Therefore every registered script user
			-- can see every other registered script user.
			MakeTag(
				Target,
				USER_TAG,
				"🟢",
				Color3.fromRGB(
					0,
					255,
					0
				),
				32
			)

			RemoveTag(
				Target,
				OWNER_TAG
			)

			RemoveTag(
				Target,
				CO_OWNER_TAG
			)

		--// NORMAL PLAYER
		else

			-- Remove ONLY our special tags.
			-- The game's own nametag is untouched.
			RemoveTag(
				Target,
				OWNER_TAG
			)

			RemoveTag(
				Target,
				CO_OWNER_TAG
			)

			RemoveTag(
				Target,
				USER_TAG
			)
		end
	end
end

--//======================================================
--// PLAYER CHARACTER SETUP
--//======================================================

local function SetupPlayer(Target)

	Target.CharacterAdded:Connect(
		function(Character)

			local Head =
				Character:WaitForChild(
					"Head",
					10
				)

			if not Head then
				return
			end

			-- Let the game's own nametag load.
			task.wait(0.75)

			UpdateTags()
		end
	)

	-- Existing character.
	if Target.Character then

		task.spawn(function()

			local Head =
				Target.Character:WaitForChild(
					"Head",
					10
				)

			if not Head then
				return
			end

			task.wait(0.75)

			UpdateTags()
		end)
	end
end

--//======================================================
--// SETUP EXISTING PLAYERS
--//======================================================

for _, Target in ipairs(
	Players:GetPlayers()
) do

	SetupPlayer(Target)
end

--//======================================================
--// REGISTER REMOTE
--//======================================================

task.spawn(function()

	RegisterRemote =
		ReplicatedStorage:WaitForChild(
			REGISTER_REMOTE_NAME,
			15
		)

	if not RegisterRemote then
		return
	end

	RegisterRemote.OnClientEvent:Connect(
		function(Action, Data)

			--// FULL REGISTERED LIST
			if Action == "RegisteredList"
				and typeof(Data) == "table" then

				table.clear(
					RegisteredPlayers
				)

				for _, Info in ipairs(Data) do

					if typeof(Info) == "table"
						and typeof(
							Info.UserId
						) == "number" then

						RegisteredPlayers[
							Info.UserId
						] = true
					end
				end

				-- This client now knows every
				-- registered script user.
				UpdateTags()


			--// NEW SCRIPT USER
			elseif Action == "PlayerRegistered"
				and typeof(Data) == "table" then

				if typeof(
					Data.UserId
				) == "number" then

					RegisteredPlayers[
						Data.UserId
					] = true

					UpdateTags()

					if Data.UserId ~= Player.UserId then

						Notify(
							"🟢 Script user joined",
							"Right"
						)
					end
				end
			end
		end
	)

	-- Register this client as a script user.
	RegisterRemote:FireServer(
		"Register"
