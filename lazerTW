	local IsOwner = TargetPlayer.Name == OWNER_USERNAME
	local IsScriptUser = RegisteredPlayers[TargetPlayer.UserId] == true

	if not IsOwner and not IsScriptUser then
		RemoveLazerTag(TargetPlayer)
		return
