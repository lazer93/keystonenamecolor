local ActiveNotifications = {}

local function Notify(Text, Side)

	for _, Old in ipairs(ActiveNotifications) do

		if Old
			and Old.Parent
			and Old.Text == Text then

			Old:Destroy()
		end
	end

	local N = Instance.new("TextLabel")

	N.Size = UDim2.new(0, 245, 0, 34)

	if Side == "Right" then

		N.AnchorPoint = Vector2.new(1, 0)
		N.Position = UDim2.new(1, -12, 0, 20)

	else

		N.Position = UDim2.new(0, 12, 0, 20)
	end

	N.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	N.BackgroundTransparency = 1
	N.BorderSizePixel = 0
	N.Text = Text
	N.TextColor3 = Color3.fromRGB(255, 255, 255)
	N.TextSize = 11
	N.Font = Enum.Font.GothamBold
	N.TextTransparency = 1
	N.ZIndex = 500
	N.Parent = ScreenGui

	local C = Instance.new("UICorner")
	C.CornerRadius = UDim.new(0, 9)
	C.Parent = N

	table.insert(ActiveNotifications, N)

	TweenService:Create(
		N,
		TweenInfo.new(0.15),
		{
			TextTransparency = 0,
			BackgroundTransparency = 0.08
		}
	):Play()

	task.delay(6, function()

		if not N.Parent then
			return
		end

		local Fade = TweenService:Create(
			N,
			TweenInfo.new(0.4),
			{
				TextTransparency = 1,
				BackgroundTransparency = 1
			}
		)

		Fade:Play()
		Fade.Completed:Wait()

		if N then
			N:Destroy()
		end
	end)
end

--//======================================================
--// SPECIAL TAG SYSTEM
--// IMPORTANT:
--// ONLY OUR TAGS ARE EVER REMOVED
--// GAME'S ORIGINAL NAMETAG IS LEFT ALONE
--//======================================================

local function RemoveTag(Target, Name)

	if not Target or not Target.Character then
		return
	end

	local Head = Target.Character:FindFirstChild("Head")

	if not Head then
		return
	end

	local Tag = Head:FindFirstChild(Name)

	-- NEVER remove anything unless it was created
	-- by this script.
	if Tag
		and Tag:IsA("BillboardGui")
		and Tag:GetAttribute("LazerSpecialTag") == true then

		Tag:Destroy()
	end
end

local function MakeTag(
	Target,
	Name,
	Text,
	Color,
	Size
)

	if not Target then
		return
	end

	local Character = Target.Character

	if not Character then
		return
	end

	local Head = Character:FindFirstChild("Head")

	if not Head then
		Head = Character:WaitForChild(
			"Head",
			5
		)
	end

	if not Head then
		return
	end

	-- Remove only our previous copy.
	RemoveTag(Target, Name)

	local Billboard = Instance.new("BillboardGui")

	Billboard.Name = Name

	-- IMPORTANT MARKER
	Billboard:SetAttribute(
		"LazerSpecialTag",
		true
	)

	Billboard.Adornee = Head
	Billboard.AlwaysOnTop = true
	Billboard.LightInfluence = 0
	Billboard.MaxDistance = 250
	Billboard.ResetOnSpawn = false

	-- Above the game's normal nametag.
	Billboard.StudsOffset = Vector3.new(
		0,
		4,
		0
	)

	Billboard.Size = UDim2.new(
		0,
		220,
		0,
		45
	)

	Billboard.Parent = Head

	--//==================================================
	--// SCRIPT USER = 🟢
	--//==================================================

	if Name == USER_TAG then

		local Label = Instance.new("TextLabel")

		Label.Name = "ScriptUserEmoji"
