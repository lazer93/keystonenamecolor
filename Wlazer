--// Toggle state
local Enabled = false
local Running = false

ToggleScript.MouseButton1Click:Connect(function()
	Enabled = not Enabled

	if Enabled then
		ToggleScript.Text = "NAME COLOR: ON"
		ToggleScript.TextColor3 = Color3.fromRGB(0, 255, 255)

		if not Running then
			Running = true

			task.spawn(function()
				local Sent = 0

				while Enabled and Sent < REQUEST_LIMIT do
					for _, Color in ipairs(Colors) do
						if not Enabled or Sent >= REQUEST_LIMIT then
							break
						end

						Event:FireServer("colo", Color)

						Sent += 1
						Status.Text = "Requests: " .. Sent .. " / " .. REQUEST_LIMIT

						task.wait(DELAY)
					end
				end

				Running = false

				if Enabled then
					Status.Text = "Finished: 900000000000000/ 9000000000000000000"
				end
			end)
		end
	else
		ToggleScript.Text = "NAME COLOR: OFF"
		ToggleScript.TextColor3 = Color3.new(1, 1, 1)
		Status.Text = "Requests: stopped"
	end
end)

