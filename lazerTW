    TweenService:Create(
        Notification,
        TweenInfo.new(0.2),
        {
            TextTransparency = 0,
            BackgroundTransparency = 0.08
        }
    ):Play()

    task.delay(3, function()
        if Notification and Notification.Parent then
            local Fade = TweenService:Create(
                Notification,
                TweenInfo.new(0.25),
                {
