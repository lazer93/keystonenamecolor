--// =========================================================

CoffeeButton.MouseButton1Click:Connect(function()

	if CoffeeClicked then

		SmallNotification(
			"YOU CAN ONLY CLICK ONE TIME"
		)

		return
	end

	CoffeeClicked = true

	CoffeeButton.Text =
		"☕ GET COFFEE: USED"

	local CoffeeEvent =
		ReplicatedStorage:FindFirstChild(
			COFFEE_REMOTE_NAME
		)

	if CoffeeEvent then

		pcall(function()
			CoffeeEvent:FireServer(
				2,
				"Coffee"
			)
		end)

	else

		SmallNotification(
			"COFFEE REMOTE NOT FOUND"
		)

	end
end)

--// =========================================================
--// DISCORD
--// =========================================================

DiscordButton.MouseButton1Click:Connect(function()

	if typeof(setclipboard) == "function" then

		pcall(function()
			setclipboard(DISCORD_LINK)
		end)

		DiscordButton.Text =
			"✓ COPIED"

		task.delay(2, function()

			if DiscordButton
				and DiscordButton.Parent then

				DiscordButton.Text =
					"☁ JOIN DISCORD"

			end
		end)

	else

		Copied.Text =
			"Discord: "
			.. DISCORD_LINK

		task.delay(5, function()

			if Copied
				and Copied.Parent then

				Copied.Text = ""

			end
		end)
	end
end)

