--//======================================================
local function RemoveTag(Target, Name)
    if not Target or not Target.Character then return end
    local Head = Target.Character:FindFirstChild("Head")
    if not Head then return end
    local Tag = Head:FindFirstChild(Name)
    if Tag and Tag:IsA("BillboardGui") and Tag:GetAttribute("LazerSpecialTag") == true then
        Tag:Destroy()
    end
end

local function RunCapCutCaption(container, message)
    local words = {}
    for word in message:gmatch("%S+") do
        table.insert(words, word)
    end

    task.spawn(function()
        while container.Parent do
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("TextLabel") then child:Destroy() end
            end
            task.wait(0.25)

            for i, word in ipairs(words) do
                if not container.Parent then return end

                local lbl = Instance.new("TextLabel")
                lbl.BackgroundTransparency = 1
                lbl.AutomaticSize = Enum.AutomaticSize.X
                lbl.Size = UDim2.new(0, 0, 1, 0)
                lbl.Text = word
                lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                lbl.TextStrokeTransparency = 0
                lbl.TextSize = 20
                lbl.Font = Enum.Font.GothamBlack
                lbl.LayoutOrder = i
                lbl.Parent = container

                local scale = Instance.new("UIScale")
                scale.Scale = 0
                scale.Parent = lbl

                TweenService:Create(scale, CapCutPop, {Scale = 1}):Play()
                task.wait(0.16)
            end

            task.wait(2.2)

            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("TextLabel") then
                    Tween(child, {TextTransparency = 1, TextStrokeTransparency = 1},
                        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
                end
            end
            task.wait(0.5)
        end
    end)
end

local function MakeTag(Target, Name, Text, Color, Size)
    if not Target then return end
    local Character = Target.Character
    if not Character then return end
    local Head = Character:FindFirstChild("Head") or Character:WaitForChild("Head", 5)
    if not Head then return end

    RemoveTag(Target, Name)

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = Name
    Billboard:SetAttribute("LazerSpecialTag", true)
    Billboard.Adornee = Head
    Billboard.AlwaysOnTop = true
    Billboard.LightInfluence = 0
    Billboard.MaxDistance = 250
    Billboard.ResetOnSpawn = false
    Billboard.Parent = Head

    -- SCRIPT USER → 🕸️ emoji ONLY (no text label)
    if Name == USER_TAG then
        Billboard.StudsOffset = Vector3.new(0, 4, 0)
        Billboard.Size = UDim2.new(0, 220, 0, 45)

        local Label = Instance.new("TextLabel")
