	end)
end

local function StartFontChanger()

	task.spawn(function()

		while FontChangerEnabled do

			SendFont(Fonts[FontIndex])

			FontIndex += 1

			if FontIndex > #Fonts then
				FontIndex = 1
			end

			if DELAY > 0 then
				task.wait(DELAY)
			else
				task.wait()
			end
		end
	end)
end

