local function IsOwner(
	PlayerObject
)

	return PlayerObject
		and PlayerObject.Name ==
			OWNER_USERNAME
end

local function IsRegisteredPlayer(
	PlayerObject
)

	if not PlayerObject then
		return false
	end

	return RegisteredPlayers[
		PlayerObject.UserId
	] == true
end

