--//======================================================
--// COMMAND REMOTE
--// ONLY NEW COMMAND ACTIONS ARE HANDLED
--//======================================================

task.spawn(function()

	CommandRemote =
		ReplicatedStorage:WaitForChild(
			COMMAND_REMOTE_NAME,
			15
		)

	if not CommandRemote then
		return
	end

	CommandRemote.OnClientEvent:Connect(
		function(
			Action,
			TargetUserId,
			Data
		)

			--// GLOBAL ALERT
			if Action == "Alert" then

				ShowGlobalAlert(
					tostring(Data)
				)

				return
			end

			--// TARGET STATUS
			if Action == "TagTargetStatus" then

				if Data == true then

					Notify(
						"🟢 You can use this cmd on this player.",
						"Left"
					)

				else

					Notify(
						"This person is not using the script so you can't use this cmd on them.",
						"Left"
					)
				end

				return
			end

			--// COMMAND RESULT
			if Action == "CommandResult" then

				if typeof(Data) == "string" then
					Notify(
						Data,
						"Left"
					)
				end

				return
			end

			--// SET PERMANENT CUSTOM TAG
			if Action == "TagSet" then

				local Target =
					Players:GetPlayerByUserId(
						TargetUserId
					)

				if Target then

					CustomTags[
						TargetUserId
					] = tostring(Data)

					MakeCustomTag(
						Target,
						tostring(Data)
					)

					Notify(
						"🏷️ Custom tag set",
						"Left"
					)
				end

				return
			end

			--// REMOVE PERMANENT CUSTOM TAG
			if Action == "TagRemoved" then

				CustomTags[
					TargetUserId
				] = nil

				local Target =
					Players:GetPlayerByUserId(
						TargetUserId
					)

				if Target then

					RemoveTag(
						Target,
						CUSTOM_TAG
					)
				end

				Notify(
					"🏷️ Custom tag removed",
					"Left"
				)

				return
			end
		end
	)
end)

