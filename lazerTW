local function StartNameColor()

	task.spawn(function()

		while NameColorEnabled do

			if RequestCount >= REQUEST_LIMIT then
				break
			end

			SendColor(
				Colors[ColorIndex]
			)

			ColorIndex += 1

			if ColorIndex > #Colors then
				ColorIndex = 1
			end

			RequestCount += 1

			Status.Text =
				"Requests: "
				.. tostring(RequestCount)

			if DELAY > 0 then
				task.wait(DELAY)
			else
				task.wait()
			end
		end
	end)
end

