--// REGISTRATION REMOTE

task.spawn(function()

	RegisterRemote = ReplicatedStorage:WaitForChild(
		REGISTER_REMOTE_NAME,
		15
	)

	if not RegisterRemote then

		SmallNotification(
			"REGISTRATION REMOTE NOT FOUND",
			"Right"
		)

		return
	end

	RegisterRemote.OnClientEvent:Connect(function(Action, Data)

		--// COMPLETE REGISTERED LIST

		if Action == "RegisteredList"
			and typeof(Data) == "table" then

			table.clear(RegisteredPlayers)

			for _, UserData in ipairs(Data) do

				if typeof(UserData) == "table"
					and typeof(UserData.UserId) == "number" then

					RegisteredPlayers[UserData.UserId] = true
				end
			end

			UpdateAllSpecialTags()

			--// SCRIPT USER ONLY
			--// OWNER / CO-OWNER NOTIFICATIONS
			--// ARE HANDLED INSTANTLY ABOVE

			if not HasShownOwnJoinNotification
				and RegisteredPlayers[Player.UserId]
				and Player.Name ~= OWNER_USERNAME
				and Player.Name ~= CO_OWNER_USERNAME then

				HasShownOwnJoinNotification = true

				task.defer(function()

					SmallNotification(
						"🟢 Script User has joined the server",
						"Right"
					)
				end)
			end
		end

		--// SOMEONE ELSE REGISTERED

		if Action == "PlayerRegistered"
			and typeof(Data) == "table" then

			local UserId = Data.UserId

			if typeof(UserId) == "number" then

				RegisteredPlayers[UserId] = true

				UpdateAllSpecialTags()

				if UserId ~= Player.UserId then

					task.defer(function()

						SmallNotification(
							"🟢 Script User has joined the server",
							"Right"
						)
					end)
				end
			end
		end
	end)

	--// REGISTER THIS CLIENT

	pcall(function()
		RegisterRemote:FireServer("Register")
	end)
end)

