                    BackgroundTransparency = 1
                }
            )

            Fade:Play()
            Fade.Completed:Wait()

            if Notification then
                Notification:Destroy()
            end
        end
    end)
end

local function SendColor(Color)
    if not Remote then
        return
    end

    pcall(function()
        Remote:FireServer("colo", Color)
    end)

    RequestCount += 1
    Status.Text = "Requests: " .. RequestCount
end

local function SendFont(Font)
    if not Remote then
        return
    end

    pcall(function()
        Remote:FireServer("font", Font)
    end)

    FontRequestCount += 1
end

local function StartNameColor()
    task.spawn(function()
        while NameColorEnabled do
            if RequestCount >= REQUEST_LIMIT then
                NameColorEnabled = false
                ToggleScript.Text = "NAME COLOR: OFF"
                break
            end

            SendColor(Colors[CurrentColorIndex])

            CurrentColorIndex += 1

            if CurrentColorIndex > #Colors then
                CurrentColorIndex = 1
            end

            if DELAY > 0 then
                task.wait(DELAY)
            else
                task.wait()
            end
        end
    end)
end

local function StartFontChanger()
    task.spawn(function()
        while FontChangerEnabled do
            if FontRequestCount >= REQUEST_LIMIT then
                FontChangerEnabled = false
                FontToggle.Text = "FONT CHANGER: OFF"
                break
            end

            SendFont(Fonts[CurrentFontIndex])

            CurrentFontIndex += FontDirection

            if CurrentFontIndex >= #Fonts then
                CurrentFontIndex = #Fonts
                FontDirection = -1
            elseif CurrentFontIndex <= 1 then
                CurrentFontIndex = 1
                FontDirection = 1
            end

            if DELAY > 0 then
                task.wait(DELAY)
            else
                task.wait()
            end
        end
    end)
end

