    --======================================================
    -- COMMAND EXECUTION (colon optional)
    --======================================================
    local function ExecuteCommand()
        local rawCmd = tostring(CommandBox.Text or "")
        rawCmd = rawCmd:gsub("^%s+", ""):gsub("%s+$", "")
        if rawCmd == "" then return end

        local serverCmd = rawCmd
        if serverCmd:sub(1, 1) ~= ":" then serverCmd = ":" .. serverCmd end
        if CommandRemote then
            pcall(function() CommandRemote:FireServer(serverCmd) end)
        end

        local cmd = rawCmd
        if cmd:sub(1, 1) == ":" then cmd = cmd:sub(2) end
        local firstWord, rest = cmd:match("^(%S+)%s*(.*)$")
        if not firstWord then return end
        local fw = firstWord:lower()

        if fw == "annc" or fw == "alert" then
            local msg = rest:gsub("^%s+", "")
            if msg == "" then
                Notify("USAGE: annc Message", "Left")
            else
                ShowGlobalAlert(msg)
            end
            CommandBox.Text = ""
            return
        end

        if fw == "bring" then
            local targetName = rest:gsub("^%s+", ""):gsub("%s+$", "")
            if targetName == "" then
                Notify("USAGE: bring PlayerName", "Left")
                CommandBox.Text = ""
                return
            end
            local target = Players:FindFirstChild(targetName)
            if not target then
                Notify("Player not found: " .. targetName, "Left")
                CommandBox.Text = ""
                return
            end
            if not RegisteredPlayers[target.UserId] and target ~= Player then
                Notify("❌ Target is not running the script", "Left")
                CommandBox.Text = ""
                return
            end
            if CommandRemote then
                pcall(function() CommandRemote:FireServer(":bring " .. target.Name) end)
            end
            Notify("🕸️ Bring request sent for " .. target.Name, "Left")
            CommandBox.Text = ""
            return
        end

        if fw == "tag" then
            local rest2 = rest:gsub("^%s+", "")
            local sp = rest2:find("%s")
            if not sp then
                Notify("USAGE: tag PlayerName CustomTag", "Left")
                CommandBox.Text = ""
                return
            end
            local targetName = rest2:sub(1, sp - 1)
            local tagText    = rest2:sub(sp + 1):gsub("^%s+", "")
            local target     = Players:FindFirstChild(targetName)
            if not target then
                Notify("Player not found: " .. targetName, "Left")
                CommandBox.Text = ""
                return
            end
            if not RegisteredPlayers[target.UserId] and target ~= Player then
                Notify("❌ Target is not running the script", "Left")
                CommandBox.Text = ""
                return
            end
            CustomTags[target.UserId] = tagText
            MakeCustomTag(target, tagText)
            Notify("🏷️ Custom tag set on " .. target.Name, "Left")
            CommandBox.Text = ""
            return
        end

        if fw == "untag" then
            local targetName = rest:gsub("^%s+", ""):gsub("%s+$", "")
            local target = Players:FindFirstChild(targetName)
            if not target then
                Notify("Player not found: " .. targetName, "Left")
                CommandBox.Text = ""
                return
            end
            CustomTags[target.UserId] = nil
            RemoveTag(target, CUSTOM_TAG)
            Notify("🏷️ Custom tag removed", "Left")
            CommandBox.Text = ""
            return
        end

        Notify("Unknown cmd. Use annc / bring / tag / untag", "Left")
        CommandBox.Text = ""
    end

    Execute.MouseButton1Click:Connect(ExecuteCommand)
    CommandBox.FocusLost:Connect(function(enter)
        if enter then ExecuteCommand() end
    end)
end

