local function SetupLocalNametag()
    if Player.Character then
        task.wait(0.2)
        CreateNametag(Player, Player.Character)
    end

    Player.CharacterAdded:Connect(function(Character)
        task.wait(0.5)
        CreateNametag(Player, Character)
    end)
end

local function SetupPlayer(PlayerObject)
    if PlayerObject == Player then
        return
    end

    CharacterConnections[PlayerObject] =
        PlayerObject.CharacterAdded:Connect(function(Character)
            task.wait(0.5)
            CreateNametag(PlayerObject, Character)
        end)

    if PlayerObject.Character then
        task.spawn(function()
            task.wait(0.5)
            CreateNametag(PlayerObject, PlayerObject.Character)
        end)
    end
end

local function RegisterPlayer(UserId)
    if UserId then
        RegisteredPlayers[UserId] = true
    end

    for _, PlayerObject in ipairs(Players:GetPlayers()) do
        if PlayerObject.Character then
            CreateNametag(PlayerObject, PlayerObject.Character)
        end
    end
end

--// Register remote
local RegisterRemote = ReplicatedStorage:FindFirstChild(REGISTER_REMOTE_NAME)

if RegisterRemote then
    RegisterRemote.OnClientEvent:Connect(function(UserId)
        if typeof(UserId) == "number" then
            RegisterPlayer(UserId)
        elseif typeof(UserId) == "Instance"
        and UserId:IsA("Player") then
            RegisterPlayer(UserId.UserId)
        end
    end)
end

--// Owner notification
local function OwnerNotification(PlayerObject)
    if IsOwner(PlayerObject) then
        SmallNotification("👑 OWNER JOINED")
    end
end

SetupLocalNametag()

for _, PlayerObject in ipairs(Players:GetPlayers()) do
    SetupPlayer(PlayerObject)

    if IsOwner(PlayerObject) then
        task.spawn(function()
            task.wait(1)
            OwnerNotification(PlayerObject)
        end)
    end
end

Players.PlayerAdded:Connect(function(PlayerObject)
    SetupPlayer(PlayerObject)

    if IsOwner(PlayerObject) then
        task.wait(1)
        OwnerNotification(PlayerObject)
    end
end)

Players.PlayerRemoving:Connect(function(PlayerObject)
    if CharacterConnections[PlayerObject] then
        CharacterConnections[PlayerObject]:Disconnect()
        CharacterConnections[PlayerObject] = nil
    end

    RegisteredPlayers[PlayerObject.UserId] = nil
end)