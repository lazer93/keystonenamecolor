local ActiveNotifs = {}
local NotifCounter = 0

local function Notify(text, side)
    for i = #ActiveNotifs, 1, -1 do
        local n = ActiveNotifs[i]
        if not n.Parent then
            table.remove(ActiveNotifs, i)
        elseif n:GetAttribute("Text") == text then
            n:Destroy()
            table.remove(ActiveNotifs, i)
        end
    end

    NotifCounter = NotifCounter + 1
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(1, 0, 0, 46)
    notif.BackgroundColor3 = Colors.Surface
    notif.BackgroundTransparency = 1
    notif.BorderSizePixel = 0
    notif.LayoutOrder = -NotifCounter
    notif:SetAttribute("Text", text)
    notif.Parent = NotifContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = notif

    local stroke = Instance.new("UIStroke")
    stroke.Color = Colors.Border
    stroke.Transparency = 1
    stroke.Parent = notif

    local accentColor = (side == "Right") and Colors.Success or Colors.Accent

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 3, 0, 22)
    accent.Position = UDim2.new(0, 0, 0.5, -11)
    accent.BackgroundColor3 = accentColor
    accent.BorderSizePixel = 0
    accent.Parent = notif
    local aCorner = Instance.new("UICorner")
    aCorner.CornerRadius = UDim.new(0, 2)
    aCorner.Parent = accent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -24, 1, 0)
    label.Position = UDim2.new(0, 16, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Colors.Text
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.TextTransparency = 1
    label.Parent = notif

    table.insert(ActiveNotifs, notif)

    Tween(notif, {BackgroundTransparency = 0.05}, EaseOutFast)
    Tween(stroke, {Transparency = 0.4}, EaseOutFast)
    Tween(label, {TextTransparency = 0}, EaseOutFast)

    task.delay(5, function()
        if not notif.Parent then return end
        Tween(notif, {BackgroundTransparency = 1})
        Tween(stroke, {Transparency = 1})
        local fade = TweenService:Create(label, EaseOut, {TextTransparency = 1})
        fade:Play()
        fade.Completed:Wait()
        notif:Destroy()
        for i = #ActiveNotifs, 1, -1 do
            if ActiveNotifs[i] == notif then table.remove(ActiveNotifs, i) end
        end
    end)
end

