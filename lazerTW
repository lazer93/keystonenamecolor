for _, PlayerObject in ipairs(Players:GetPlayers()) do
    if PlayerObject ~= Player then
        SetupPlayer(PlayerObject)

        if IsOwner(PlayerObject) then
            RegisteredPlayers[PlayerObject.UserId] = true
