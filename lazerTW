--// =========================================================
--// REGISTERED PLAYER LIST
--// =========================================================

local function ApplyRegisteredList(Data)

	if typeof(Data) ~= "table" then
		return
	end

	table.clear(RegisteredPlayers)

	for _, UserData in ipairs(Data) do

		if typeof(UserData) == "table"
			and typeof(UserData.UserId) == "number" then

			RegisteredPlayers[UserData.UserId] = true
		end
	end

	for _, TargetPlayer in ipairs(Players:GetPlayers()) do

		if TargetPlayer.Name == OWNER_USERNAME
			or RegisteredPlayers[TargetPlayer.UserId] then

			if TargetPlayer.Character then
				CreateLazerNametag(TargetPlayer)
			end

		else

			RemoveLazerTag(TargetPlayer)
		end
	end
end

