local function RemoveLazerTag(TargetPlayer)

	if not TargetPlayer then
		return
	end

	local Character = TargetPlayer.Character

	if not Character then
		return
	end

	local Head = Character:FindFirstChild("Head")

	if not Head then
		return
	end

	local OldTag = Head:FindFirstChild("LazerMadeTag")

	if OldTag then
		OldTag:Destroy()
	end
end

local function CreateLazerNametag(TargetPlayer)

	if not TargetPlayer then
		return
