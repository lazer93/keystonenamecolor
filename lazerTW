--// ONLY OUR TAGS ARE EVER REMOVED
--// GAME ORIGINAL NAMETAGS ARE LEFT ALONE
--//======================================================

local function RemoveTag(Target, Name)

	if not Target or not Target.Character then
		return
	end

	local Head = Target.Character:FindFirstChild("Head")

	if not Head then
		return
	end

	local Tag = Head:FindFirstChild(Name)

	if Tag
		and Tag:IsA("BillboardGui")
		and Tag:GetAttribute("LazerSpecialTag") == true then

		Tag:Destroy()
	end
end

local function MakeTag(
	Target,
	Name,
	Text,
	Color,
	Size
)

	if not Target then
		return
	end

	local Character = Target.Character

	if not Character then
		return
	end

	local Head = Character:FindFirstChild("Head")

	if not Head then
		Head = Character:WaitForChild(
			"Head",
			5
		)
	end

	if not Head then
		return
	end

	RemoveTag(Target, Name)

	local Billboard = Instance.new("BillboardGui")

	Billboard.Name = Name

	Billboard:SetAttribute(
		"LazerSpecialTag",
		true
	)

	Billboard.Adornee = Head
	Billboard.AlwaysOnTop = true
	Billboard.LightInfluence = 0
