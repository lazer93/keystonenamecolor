local function SetupLocalNametag()
    if CharacterConnections[Player] then
        CharacterConnections[Player]:Disconnect()
        CharacterConnections[Player] = nil
    end

    RegisteredPlayers[Player.UserId] = true

    CharacterConnections[Player] = Player.CharacterAdded:Connect(function(Character)
        task.wait(0.5)
        RegisteredPlayers[Player.UserId] = true
        CreateNametag(Player, Character)
    end)

    if Player.Character then
        task.spawn(function()
            task.wait(0.5)
            RegisteredPlayers[Player.UserId] = true
            CreateNametag(Player, Player.Character)
        end)
    end
end

local function SetupPlayer(PlayerObject)
    if CharacterConnections[PlayerObject] then
        CharacterConnections[PlayerObject]:Disconnect()
        CharacterConnections[PlayerObject] = nil
    end

    CharacterConnections[PlayerObject] = PlayerObject.CharacterAdded:Connect(function(Character)
        task.wait(0.5)

        if RegisteredPlayers[PlayerObject.UserId] or IsOwner(PlayerObject) then
            CreateNametag(PlayerObject, Character)
        end
    end)

    if PlayerObject.Character then
        task.spawn(function()
            task.wait(0.5)

            if RegisteredPlayers[PlayerObject.UserId] or IsOwner(PlayerObject) then
                CreateNametag(PlayerObject, PlayerObject.Character)
            end
        end)
    end
end

local function RegisterPlayer(UserId)
    if typeof(UserId) ~= "number" then
        return
    end

    RegisteredPlayers[UserId] = true

    local TargetPlayer = Players:GetPlayerByUserId(UserId)

    if TargetPlayer then
        SetupPlayer(TargetPlayer)

        if TargetPlayer.Character then
            CreateNametag(TargetPlayer, TargetPlayer.Character)
        end
    end
end

local function OwnerNotification(PlayerObject)
    if IsOwner(PlayerObject) then
        SmallNotification("👑 OWNER JOINED")
    end
end

if RegisterRemote then
    RegisterRemote.OnClientEvent:Connect(function(Action, Data)
        if Action == "Registered" then
            if typeof(Data) == "number" then
                RegisterPlayer(Data)

            elseif typeof(Data) == "table" then
                for _, UserId in ipairs(Data) do
                    RegisterPlayer(UserId)
                end
            end

        elseif Action == "NewRegisteredPlayer" then
            if typeof(Data) == "number" then
                RegisterPlayer(Data)
            end
        end
    end)
end

