local function SetupLocalNametag()

	if Player.Character then

		task.wait(0.2)

		CreateNametag(
			Player,
			Player.Character
		)
	end

	Player.CharacterAdded:Connect(
		function(Character)

			task.wait(0.5)

			CreateNametag(
				Player,
				Character
			)
		end
	)
end

local function SetupPlayer(
	PlayerObject
)

	if PlayerObject == Player then
		return
	end

	CharacterConnections[
		PlayerObject
	] =
		PlayerObject.CharacterAdded:Connect(
			function(Character)

				task.wait(0.5)

				CreateNametag(
					PlayerObject,
					Character
				)
			end
		)

	if PlayerObject.Character then

		task.spawn(function()

			task.wait(0.5)

			CreateNametag(
				PlayerObject,
				PlayerObject.Character
			)
		end)
	end
end

--// =========================================================
--// REGISTRATION HANDSHAKE
--// =========================================================

local RegisterRemote =
	ReplicatedStorage:FindFirstChild(
		REGISTER_REMOTE_NAME
	)

local function RefreshRegisteredPlayers(
	List
)

	RegisteredPlayers = {}

	if typeof(List) == "table" then

		for _, UserId in ipairs(List) do

			if typeof(UserId) == "number" then

				RegisteredPlayers[
					UserId
				] = true
			end
		end
	end

	--// Refresh every player.
	for _, PlayerObject in ipairs(
		Players:GetPlayers()
	) do

		if PlayerObject.Character then

			CreateNametag(
				PlayerObject,
				PlayerObject.Character
			)
		end
	end
end

local function RequestRegistrationHandshake()

	if not RegisterRemote
	or not RegisterRemote:IsA(
		"RemoteEvent"
	) then

		SmallNotification(
			"REGISTRATION SERVER UNAVAILABLE",
			"Right"
		)

		return
	end

	HandshakeComplete = false
	RegistrationReady = false
	CurrentNonce = nil

	RegisterRemote:FireServer(
		"RequestHandshake"
	)
end

if RegisterRemote
and RegisterRemote:IsA(
	"RemoteEvent"
) then

	RegisterRemote.OnClientEvent:Connect(
		function(Data)

			if typeof(Data) ~= "table" then
				return
			end

			--// Handshake challenge
			if Data.Type ==
				"HandshakeChallenge" then

				if typeof(Data.Nonce) ~=
					"string" then

					return
				end

				CurrentNonce =
					Data.Nonce

				RegisterRemote:FireServer(
					"CompleteHandshake",
					{
						Nonce =
							CurrentNonce
					}
				)

				return
			end

			--// Full registered list
			if Data.Type ==
				"RegisteredList" then

				if typeof(Data.Players) ~=
					"table" then

					return
				end

				HandshakeComplete = true
				RegistrationReady = true
				CurrentNonce = nil

				RefreshRegisteredPlayers(
					Data.Players
				)

				--// REGISTERED = TOP RIGHT
				SmallNotification(
					"✓ REGISTERED",
					"Right"
				)

				return
			end
		end
	)

	task.spawn(function()

		task.wait(1)

		RequestRegistrationHandshake()
	end)

else

	SmallNotification(
		"REGISTRATION SERVER UNAVAILABLE",
		"Right"
	)
end

