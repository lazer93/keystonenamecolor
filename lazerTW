local NameColorEnabled = false
local CurrentColorIndex = 1
local RequestCount = 0

local function UpdateToggle()
	if NameColorEnabled then
		ToggleScript.Text = "NAME COLOR: ON"
		ToggleScript.TextColor3 = Color3.fromRGB(0, 255, 80)
		ToggleStroke.Color = Color3.fromRGB(0, 255, 80)
	else
		ToggleScript.Text = "NAME COLOR: OFF"
		ToggleScript.TextColor3 = Color3.fromRGB(255, 255, 255)
		ToggleStroke.Color = Color3.fromRGB(255, 255, 255)
	end
end

local function SendColor(Color)
	if not Event then
		SmallNotification("Color remote not found")
		return
	end

	local Success = pcall(function()
		Event:FireServer("colo", Color)
	end)

	if Success then
		RequestCount += 1
		Status.Text = "Requests: " .. tostring(RequestCount)
	end
end

local function StartNameColor()
	task.spawn(function()
		while NameColorEnabled do
			if #Colors == 0 then
				break
			end

			SendColor(Colors[CurrentColorIndex])

			CurrentColorIndex += 1

			if CurrentColorIndex > #Colors then
				CurrentColorIndex = 1
			end

			if DELAY > 0 then
				task.wait(DELAY)
			else
				task.wait()
			end
		end
	end)
end

ToggleScript.MouseButton1Click:Connect(function()
	NameColorEnabled = not NameColorEnabled

	UpdateToggle()

	if NameColorEnabled then
		StartNameColor()
		SmallNotification("✓ Name color enabled")
	else
		SmallNotification("Name color disabled")
	end
end)

UpdateToggle()

