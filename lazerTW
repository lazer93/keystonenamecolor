local GUIOpen = true

local function SetGUI(State)

	GUIOpen = State

	if State then

		Main.Visible = true
		OpenButton.Visible = false

		Main.Size = UDim2.new(0, 300, 0, 205)

		TweenService:Create(
			Main,
			TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{
				Size = UDim2.new(0, 300, 0, 225)
			}
		):Play()

	else

		TweenService:Create(
			Main,
			TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
			{
				Size = UDim2.new(0, 300, 0, 0)
			}
		):Play()

		task.delay(0.22, function()

			if not GUIOpen then
				Main.Visible = false
				OpenButton.Visible = true
			end

		end)
	end
end

