--// =========================================================
--// PLAYER LEAVING
--// =========================================================

Players.PlayerRemoving:Connect(
	function(PlayerObject)

		if CharacterConnections[
			PlayerObject
		] then

			CharacterConnections[
				PlayerObject
			]:Disconnect()

			CharacterConnections[
				PlayerObject
			] = nil
		end

		RegisteredPlayers[
			PlayerObject.UserId
		] = nil
	end
)